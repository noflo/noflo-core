  "repository": {
    "type": "git",
    "url": "https://github.com/noflo/noflo-core.git"
  },
  "license": "MIT",
  "dependencies": {
    "noflo": "^1.0.0",
    "owl-deepcopy": "~0.0.4"
  },
  "devDependencies": {
    "chai": "^4.0.0",
    "eslint": "^8.14.0",
    "eslint-config-airbnb-base": "^14.0.0",
    "eslint-plugin-chai": "0.0.1",
    "eslint-plugin-import": "^2.12.0",
    "eslint-plugin-mocha": "^10.0.4",
    "fbp-spec": "^0.8.0",
    "mocha": "^10.0.0",
    "noflo-nodejs": "^0.15.0",
    "noflo-webpack-config": "^2.0.0"
  },
  "keywords": [
    "noflo"
  ],
  "scripts": {
    "pretest": "eslint *.js components/*.js spec/mocha/*.js",
    "test:mocha:node": "mocha --exit --require node_modules/noflo-webpack-config/inject.js spec/mocha/*.js",
    "test:fbp-spec:node": "fbp-spec --secret test --address ws://localhost:3333 --command 'noflo-nodejs --port 3333 --secret test' spec/*.yaml",
    "test": "npm run test:mocha:node && npm run test:fbp-spec:node"
  }
}
