{
  "name": "@noflo/core",
  "description": "NoFlo Essentials",
  "version": "2.0.0-alpha.1",
  "author": {
    "name": "Henri Bergius",
    "email": "henri.bergius@iki.fi"
  },
  "maintainers": [
    {
      "name": "Kenneth Kan",
      "email": "kenhkan@gmail.com"
    }
  ],
  "contributors": [
    {
      "name": "Kenneth Kan",
      "email": "kenhkan@gmail.com"
    },
    {
      "name": "Ryan Shaw",
      "email": "ryanshaw@unc.edu"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noflo/noflo-core.git"
  },
  "license": "MIT",
  "dependencies": {
    "@noflo/noflo": "^2.0.0-alpha.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@noflo/fbp-spec-runner": "^2.0.0-alpha.3",
    "@noflo/loader-node": "^2.0.0-alpha.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "noflo"
  ],
  "scripts": {
    "lint": "npx @biomejs/biome check --use-editorconfig=true components/ spec/ test/",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write components/ spec/ test/",
    "types": "tsc -p tsconfig.json",
    "test": "npm run types && npm run lint && npm run test:spec && npm run test:node",
    "test:spec": "node \"$(node -p \"require.resolve('@noflo/fbp-spec-runner/src/cli.js')\")\" spec/",
    "test:node": "node --test test/*.test.js",
    "test:bun": "bun test test/*.test.js",
    "test:deno": "deno test --allow-all --no-check test/*.test.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "components/",
    "graphs/",
    "spec/",
    "test/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
